{
  "name": "nova-music-lab",
  "private": true,
  "version": "1.6.0",
  "description": "Local-first React and TypeScript music museum presenting Kevin Cusnir / Lirioth Teltanion's listening history and letting visitors privately explore their own archives through evidence-aware, non-clinical interpretations.",
  "homepage": "https://liriothteltanion.github.io/NovaMusicLab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiriothTeltanion/NovaMusicLab.git"
  },
  "bugs": {
    "url": "https://github.com/LiriothTeltanion/NovaMusicLab/issues"
  },
  "author": {
    "name": "Kevin Cusnir",
    "url": "https://github.com/LiriothTeltanion"
  },
  "license": "MIT",
  "keywords": [
    "music-analytics",
    "music-discovery",
    "local-first",
    "data-visualization",
    "react",
    "typescript",
    "indexeddb",
    "accessibility",
    "internationalization"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && node scripts/check_bundle_budget.mjs",
    "verify": "npm run lint && npm run audit:data:strict && npm run audit:genres && npm run audit:identity && npm run audit:links && npm run audit:knowledge && npm run audit:privacy && npm run audit:pwa && npm run audit:share && npm run test && npm run build:check",
    "verify:release": "npm run verify && npm run audit:release-media",
    "lint": "oxlint",
    "audit:dependencies": "npm audit",
    "compile:data": "node scripts/compile_kevin_music_dna.mjs",
    "lastfm:export": "node scripts/export_lastfm_history.mjs",
    "audit:data": "node scripts/audit_data_quality.mjs",
    "audit:data:strict": "node scripts/audit_data_quality.mjs --strict",
    "genres:sync": "node scripts/sync_genre_ontology.mjs",
    "genres:build": "node scripts/build_artist_genre_assertions.mjs",
    "audit:genres": "node scripts/audit_genre_knowledge.mjs",
    "audit:identity": "node scripts/audit_artist_identity.mjs",
    "audit:links": "node scripts/audit_media_links.mjs --strict",
    "audit:privacy": "node scripts/audit_public_bundle_privacy.mjs",
    "audit:share": "node scripts/sync_share_metrics.mjs --check",
    "share:sync": "node scripts/sync_share_metrics.mjs",
    "audit:pwa": "node scripts/audit_pwa_contract.mjs",
    "knowledge:artists": "node scripts/build_offline_artist_knowledge.mjs",
    "knowledge:manifest": "node scripts/build_artist_knowledge_manifest.mjs && node scripts/enrich_wikimedia_commons_rights.mjs --write",
    "audit:knowledge": "node scripts/audit_artist_knowledge_manifest.mjs",
    "audit:release-media": "node scripts/audit_release_media.mjs",
    "release:stamp-deployment": "node scripts/stamp_deployment_attestation.mjs",
    "i18n:hebrew": "node scripts/generate_hebrew_ui.mjs",
    "i18n:hebrew:central": "node scripts/generate_hebrew_ui.mjs --central-only",
    "i18n:hebrew:data": "node scripts/generate_hebrew_ui.mjs --json-only",
    "icons:generate": "node scripts/generate_nova_icons.mjs",
    "screenshots:capture": "node scripts/capture_readme_visuals.mjs",
    "test": "vitest run --maxWorkers 1 --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "gifenc": "1.0.3",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.1.1",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
